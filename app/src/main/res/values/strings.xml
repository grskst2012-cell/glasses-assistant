    <string name="tool_err_no_city">ERROR: no city given. Ask the user which city the weather is for.</string>
    <string name="tool_err_city_not_found">ERROR: city “%1$s” not found.</string>
    <string name="tool_err_no_currency">ERROR: these currencies are not in the Bank of Russia data.</string>
    <string name="tool_err_empty_query">ERROR: empty query.</string>
    <string name="tool_weather">City: %1$s. Now %2$d °C (feels like %3$d), %4$s, wind %5$d m/s. Today from %6$d to %7$d °C, chance of precipitation %8$d %%. Data as of %9$s. Source: Open-Meteo.</string>
    <string name="tool_currency_item">%1$s: %2$s rub. per %3$s (yesterday %4$s)</string>
