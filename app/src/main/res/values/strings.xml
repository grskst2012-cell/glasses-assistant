    <!-- Settings: background, shortcuts, privacy -->
    <string name="sec_background">Background work</string>
    <string name="bg_desc">The assistant lives in a notification (with “Talk”, “Microphone” and “Stop” buttons) and listens with the screen off. It has to be started from the open app, a tile, a widget or the “Talk” shortcut: an Android 14+ rule.</string>
    <string name="bg_ok">Battery restrictions removed</string>
    <string name="bg_btn">Remove battery restrictions</string>
    <string name="sec_shortcuts">Quick start</string>
    <string name="shortcuts_desc">Add the “Assistant” tile to Quick Settings or the widget to your home screen: one tap starts the assistant, or talks if it is already running. Long-press the app icon for the “Talk” shortcut.</string>
    <string name="sec_privacy">Privacy</string>
    <string name="privacy_desc">While the assistant runs, Android shows the microphone indicator. Requests go to the model provider you chose; history is kept only in the app’s memory.</string>
    <string name="btn_clear">Clear conversation history</string>

